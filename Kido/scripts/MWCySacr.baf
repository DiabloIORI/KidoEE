IF
  True()
THEN
  RESPONSE #100
CutSceneID("MWDolf")
FaceObject(Player1)
MoveViewObject(Myself,INSTANT)
CreateCreatureImpassable("girl02",[437.324],0)
DisplayStringWait("girl02",~呜……你、你要把我怎么样？~)
Wait(1)
DisplayStringWait(Myself,~你将要以希瑞克之名被献祭！~)
Wait(1)
DisplayStringWait("girl02",~不！不……呜……我不想死。求你，呜……放我走吧！~)
PlaySound("FCHIL02")
Wait(1)
DisplayStringWait(Myself,~不！哈哈哈！~)
MoveToObject("girl02")
SwingOnce()
DisplayStringWait(Myself,~上祭坛去……~)
ActionOverride("girl02",SetSequence(SEQ_SLEEP))
Wait(2)
DisplayStringWait(Myself,~哦，伟大的希瑞克，至高之至高，黑太阳，谎言之君，我在此献祭此女，好让你以你之名占有这座礼拜之所！~)
PlaySound("CAS_P07")
CreateVisualEffectObject("SPWHIRL","girl02")
Wait(6)
ApplyDamage("girl02",900,PIERCING)
Wait(3)
SetGlobal("Kidopersonalquest","GLOBAL",6)
EndCutSceneMode()
END