Wait(2)
CreateVisualEffectObject("SPUNHBL3",Myself)
CreateVisualEffectObject("SPSDIMPA",Myself)
Wait(1)
CreateVisualEffectObject("SPUNHBL3",Myself)
CreateVisualEffectObject("SPSDIMPA",Myself)
Wait(1)
CreateVisualEffectObject("SPUNHBL3",Myself)
CreateVisualEffectObject("SPSDIMPA",Myself)
Wait(1)
CreateVisualEffectObject("SPWRDFLD",Myself)
Wait(1)
CreateVisualEffectObject("SPCRTWPN",Myself)
