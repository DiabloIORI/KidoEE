IF 
  HotKey(T) 
THEN 
  RESPONSE #100 
    StartCutSceneMode() 
    StartCutScene("MWKIDFIX") 
END

IF
LevelGT(Myself,27)
!Global("gotkhosy","LOCALS",1)
Global("gotkhosy25","LOCALS",0)
THEN
RESPONSE #100
CreateItem("MWkihosy",1,0,0)
CreateVisualEffectObject("SPDISPMA","MWKido")
DisplayStringHead(Myself, ~基多又一次把规矩踩了个遍，因为基多刚得了希瑞克赐下的一枚强大圣徽。它专为契合基多的特殊特质而造。~)
SetGlobal("gotkhosy25","LOCALS",1)
END

IF
InParty(Myself)
See(Player1)
!StateCheck(Player1,CD_STATE_NOTVALID)
CombatCounter(0)
Global("METBAL","GLOBAL",1)
Global("kidoknowbal","GLOBAL",0)
THEN
RESPONSE #100
SetGlobal("kidoknowbal","GLOBAL",1)
FaceObject(Player1)
Dialog(Player1)
END

